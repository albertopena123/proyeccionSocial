# next-auth (beta.32) declara nodemailer ^7||^8 como peer OPCIONAL (solo lo usa su
# proveedor de email, que no se emplea aqui). nodemailer 9.0.6 es la primera version
# sin CVEs abiertos (GHSA-p6gq-j5cr-w38f afecta a <=9.0.0), asi que se relaja la
# comprobacion de peers en lugar de quedarse en una version vulnerable.
legacy-peer-deps=true
